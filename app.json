{
  "expo": {
    "name": "Nafs",
    "slug": "nafs-30-day-transformation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nafs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "A free 30-day Islamic spiritual transformation app with daily plans, dhikr, Quran goals, and character building exercises.",
    "android": {
      "package": "com.nafs.transformation",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#1B4332"
      },
      "permissions": ["NOTIFICATIONS"],
      "versionCode": 1
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nafs.transformation",
      "buildNumber": "1"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2D6A4F"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://nafs.app/privacy",
      "supportEmail": "nafs.app.support@gmail.com"
    }
  }
}
