{
  "expo": {
    "name": "Nafs",
    "slug": "nafs-30-day-transformation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nafs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "A free 30-day Islamic spiritual transformation app with daily plans, dhikr, Quran goals, and character building exercises.",
    "android": {
      "package": "com.nafs.transformation",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#3E5A48"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nafs.transformation"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3E5A48"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4A6352"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://nafs.app/privacy",
      "supportEmail": "nafs.app.support@gmail.com"
    }
  }
}
